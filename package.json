{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "TZ=Asia/Riyadh NODE_ENV=development NODE_OPTIONS='--max-old-space-size=4096' tsx server/index.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/copy-migrations.js && node scripts/write-version.js",
    "start": "npm run build && TZ=Asia/Riyadh NODE_ENV=production NODE_OPTIONS='--max-old-space-size=2048' node dist/index.js",
    "check": "tsc",
    "test": "vitest run --config vitest.config.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/run_pending_migrations.ts",
    "db:migrate-file": "node --import tsx scripts/run_migration.ts",
    "db:init-affiliate": "tsx scripts/init-affiliate-products.ts",
    "db:test-scraping": "tsx scripts/test-scraping.ts",
    "db:populate-products": "tsx scripts/populate-sample-products.ts",
    "db:dump": "pg_dump --no-owner --no-privileges --format=plain $DATABASE_URL > backup.sql",
    "db:restore": "psql $DATABASE_URL < backup.sql",
    "db:counts": "tsx scripts/db_counts.ts",
    "deduct-credits": "tsx scripts/run_deduct_credits.ts",
    "migrate:food": "tsx scripts/migrate_food_data.ts",
    "migrate:food-items": "tsx scripts/migrate_food_items.ts",
    "migrate:food:reset": "tsx scripts/reset_and_migrate_food_items.ts",
    "check:food-items": "tsx scripts/check_food_items.ts",
    "db:seed-supplements": "tsx scripts/seed_supplements.ts",
    "tenant:migrate-all": "tsx scripts/run-tenant-migrations-all.ts",
    "admin:promote-super": "tsx scripts/promote_super_admin.ts"
  },

# Copy to .env and fill in values.

# --- Railway PostgreSQL ---
# INTERNAL (works only inside Railway, e.g. naioshfit app service):
#   postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
# PUBLIC (required for local dev / Cursor Cloud — Postgres → Connect → Public Network):
#   postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require
#
# On the Railway *app* service, prefer: DATABASE_URL=${{Postgres.DATABASE_URL}}

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=5000

# Production domain (Railway / SaaS)
MAIN_DOMAIN=naioshfit.com

# Optional SaaS multi-tenant (Railway production)
# Auto-derived from DATABASE_URL + SESSION_SECRET when unset (see server/saas/tenantEnv.ts).
# Set SAAS_AUTO_TENANT_ENV=0 to require explicit values below.
# CENTRAL_DATABASE_URL=
# TENANT_DB_ENCRYPTION_KEY=
# TENANT_DATABASE_URL_TEMPLATE=
# PROVISIONING_ADMIN_DATABASE_URL=
# SAAS_ADMIN_TOKEN=

# Optional dev
ALLOW_LOCAL_AI_FALLBACK=true

# Copy to .env and fill in values.
# For Railway Postgres: open Postgres service → Connect → copy DATABASE_URL (Public Network).

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=5000

# Production domain (Railway / SaaS)
MAIN_DOMAIN=naioshfit.com

# Optional SaaS multi-tenant (Railway production)
# CENTRAL_DATABASE_URL=
# TENANT_DB_ENCRYPTION_KEY=
# TENANT_DATABASE_URL_TEMPLATE=
# PROVISIONING_ADMIN_DATABASE_URL=
# SAAS_ADMIN_TOKEN=

# Optional dev
ALLOW_LOCAL_AI_FALLBACK=true
